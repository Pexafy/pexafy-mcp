# Copy to .env and fill in. .env is NEVER committed (see .gitignore).
# In Docker, these come from docker-compose / the environment instead.
#
# Every variable the server reads is listed here, grouped, with the default the code
# applies when it is unset. All of them are optional. Most are read once, at import.
#
# An EMPTY value is not the same as an unset one: `PEXAFY_WEB_URL=` blanks the site's
# address and `PEXAFY_HTTP_TIMEOUT=` fails to parse. To keep a default, leave the line
# commented. The value on a commented line is the default — or empty, where the comment
# above it says what the unset variable does instead.

# ── Transport ─────────────────────────────────────────────────────────────────
# "stdio" (Claude Desktop/Code, a container driven by a client) or "http" (remote
# Streamable HTTP). Any other value runs stdio.
# PEXAFY_MCP_TRANSPORT=stdio
# Bind address and port of the HTTP transport.
# PEXAFY_MCP_HOST=127.0.0.1
# PEXAFY_MCP_PORT=8765
# This server's public base URL, as clients reach it (e.g. https://mcp.example.com).
# Used for the OAuth protected-resource metadata and the account-link challenge, for the
# widget domain Claude requires (derived from <url>/mcp), in the grid's CSP, and as the
# address the grid posts the reader's selection to. Unset: http://<HOST>:<PORT> for the
# first three, and no selection channel at all.
# PEXAFY_MCP_PUBLIC_URL=

# ── Pexafy API ────────────────────────────────────────────────────────────────
# API root (the OpenAPI paths already include /api/v1). The code default is
# http://localhost:8000 (local dev); this file pre-points it at the public API so a
# fresh checkout works out of the box. Override it for your own deployment.
PEXAFY_API_BASE_URL=https://api.pexafy.com
# The key this server calls the API with when a request brings none of its own: a local
# stdio run, and — with anonymous access on — the service key whose calls the API
# attributes to the signed principal (see below). A caller's own credential (OAuth
# token, `Authorization: Bearer`, `x-api-key`) always takes precedence. Careful on an
# HTTP server with neither OAuth nor anonymous access: this key then serves anyone who
# can reach the server.
PEXAFY_API_KEY=
# Analytics tag sent to the API as the X-Source header.
PEXAFY_SOURCE=MCP-Agent
# Seconds allowed for an API call.
# PEXAFY_HTTP_TIMEOUT=30
# Retries on connection failures only (DNS, refused, reset); an HTTP error is not re-sent.
# PEXAFY_HTTP_RETRIES=2
# The Pexafy website: the grid's "Full results" links (/?q=…, /photos/<id>/) and the
# base of the sign-in and home links below.
# PEXAFY_WEB_URL=https://pexafy.com
# The API keys page: where the "API key limit reached" message sends a user to free a
# key, and the link the 401 answer gives for keys.
# PEXAFY_CONNECTORS_URL=https://pexafy.com/dashboard/api-keys/

# ── OAuth resource server (HTTP transport only) ───────────────────────────────
# Engages when the transport is http and all three are set: clients then authenticate
# per user with OAuth against an external Authorization Server, and each opaque token is
# resolved, on every request, to that user's Pexafy API key. See auth.py.
# Endpoint that validates a token and returns the user's key (Pexafy: /oauth/mcp/resolve).
# PEXAFY_OAUTH_RESOLVE_URL=
# Shared secret sent to that endpoint.
# MCP_RESOLVE_SECRET=
# The Authorization Server's issuer URL, advertised in the protected-resource metadata.
# PEXAFY_OAUTH_AS_URL=

# ── Access without an account ─────────────────────────────────────────────────
# Serve callers who send no credential at all, on the API's daily allowance for callers
# without an account. Needs PEXAFY_ANON_SECRET and, as the service key, PEXAFY_API_KEY;
# without the secret it stays off. See anonymous.py.
# PEXAFY_ANON_ENABLED=0
# HMAC key the caller's identity is signed with (X-Pexafy-Principal). Must be the secret
# the Pexafy API verifies principals with, byte for byte. It is also the key of the
# salted hash that names the caller (never the subject or the address itself): changing
# it starts every anonymous allowance again from zero.
# PEXAFY_ANON_SECRET=
# Seconds a signed principal stays valid.
# PEXAFY_ANON_TTL=300
# Where an identity is looked for, in order: `openai-subject` (ChatGPT's per-person id),
# `ip` (the caller's address), `mcp-session` (the session id this server issues — opt-in:
# a client can open a new session, and with it a new allowance).
# PEXAFY_ANON_SOURCES=openai-subject,ip
# Networks where an address stands for a crowd and names nobody (default: Claude.ai's
# egress range). A caller there gets the 401 that starts OAuth. Comma-separated CIDRs.
# PEXAFY_ANON_SHARED_NETWORKS=160.79.104.0/21
# Mark `openai/subject` as attested only when the request comes from an address OpenAI
# publishes. 0 takes it at face value: acceptable only where nobody else can reach the server.
# PEXAFY_ANON_ATTEST_OPENAI=1
# The list of those addresses, and how often it is refreshed (seconds). It is fetched by
# the first call that needs it; after a failed fetch the next try waits 60 seconds.
# PEXAFY_ANON_OPENAI_FEED=https://openai.com/chatgpt-connectors.json
# PEXAFY_ANON_FEED_TTL=3600

# ── Allowances ────────────────────────────────────────────────────────────────
# Read from the API's X-Plan / X-Quota-* / X-Daily-Quota-* headers. See budget.py.
# Attach a `budget` block to answers close to the end of an allowance.
# PEXAFY_BUDGET_NOTICE=1
# Share of the allowance SPENT from which that block appears.
# PEXAFY_BUDGET_WARN_AT=0.8
# Offer the way in: the sign-in link to a caller without an account, the options page
# to one who has run out. 0 leaves the bare counter.
# PEXAFY_BUDGET_ACCOUNT_CTA=1
# A spent daily or monthly allowance comes back as an empty result with a `notice`,
# which the grid draws. 0 returns a tool error instead.
# PEXAFY_BUDGET_WALL_GRID=1
# The sign-in form (default: PEXAFY_WEB_URL + /auth/login/).
# PEXAFY_SIGNIN_URL=https://pexafy.com/auth/login/
# Where the account button of a signed-in caller leads (default: PEXAFY_WEB_URL + /).
# PEXAFY_HOME_URL=https://pexafy.com/
# An informational page about allowances, for a signed-in caller who has run out.
# Empty: no link at all.
# PEXAFY_ACCOUNT_OPTIONS_URL=

# ── Account linking ───────────────────────────────────────────────────────────
# Declare `noauth` + `oauth2` in `securitySchemes` on every tool, and register
# `connect_account`, which asks the host to open its own OAuth flow. Meant for a server
# that runs OAuth AND serves callers without an account; set 0 otherwise. See linking.py.
# PEXAFY_ACCOUNT_LINKING=1
# The `error` code of the challenge the host reads. Empty falls back to the default:
# OpenAI requires both `error` and `error_description` in the challenge.
# PEXAFY_LINK_ERROR=insufficient_scope
# Also send the challenge when an allowance runs out, not only when someone asks.
# PEXAFY_LINK_AT_WALL=0
# Hosts other than ChatGPT (VS Code, Cursor, Claude Code…) sign in only when a request is
# refused with a 401. With OAuth and access without an account both on, their asking to
# connect — the grid's Sign in, or connect_account — is answered 401, so that the client
# runs its own OAuth sign-in; an editor that signed in is then answered 401 at each
# session start from that machine, so that it sends its token (remembered in the store,
# PEXAFY_REDIS_URL). On when unset or empty; 0/false/no/off, or any other unrecognised
# value, serves those requests anonymously, with no 401. See anonymous.py.
# PEXAFY_SIGN_IN_BY_401=1

# ── Thumbnails, the grid and the photo file ───────────────────────────────────
# Pexafy's signed thumbnail proxy (e.g. https://thumb.pexafy.com) and its signing
# secret. BOTH are needed for the inline grid and for get_photo_file_by_photo_id;
# without them results stay structured data. See previews.py.
# PEXAFY_THUMB_BASE_URL=
# PEXAFY_THUMB_HMAC_SECRET=
# Previews are on when the proxy is configured. Unset or empty keeps that default;
# 1/true/yes/on keep them on; any other value turns the grid and the file tool off.
# PEXAFY_MCP_PREVIEWS=1
# Width of the grid's thumbnails, how long their signature lasts (seconds; 30 days),
# and the step the expiry is rounded up to, so a photo gets the same URL all day.
# PEXAFY_THUMB_WIDTH=480
# PEXAFY_THUMB_URL_TTL=2592000
# PEXAFY_THUMB_URL_STEP=86400
# Where the grid's image links travel: `both` (the result's `_meta` and its content),
# `meta` (`_meta` only — kept from the model), `content` (the model's half only).
# PEXAFY_PREVIEWS_CHANNEL=both
# Largest photo file get_photo_file_by_photo_id hands over (bytes; 6 MiB).
# PEXAFY_PHOTO_FILE_MAX_BYTES=6291456
# Also return the file's bytes as an embedded resource, beside the image content: `auto`
# (the default) for an OpenAI host only — Claude caps a tool result, and two base64 copies
# of a photo reach the cap; 1/true/yes/on for every host; anything else for none.
# PEXAFY_PHOTO_FILE_RESOURCE=auto

# ── Reference images (search_photos_by_image) ────────────────────────────────
# Deadline for downloading an image URL, DNS and redirects included (seconds); also the
# timeout of the photo-file download.
# PEXAFY_IMG_FETCH_TIMEOUT=15
# Largest reference image accepted, from a URL or base64 (bytes; 10 MiB less 16 KiB —
# the Pexafy API caps the whole request at 10 MiB, MAX_BODY_SIZE, and the multipart
# framing around the image takes a few hundred bytes of it: raising it here only moves
# the refusal to the API). The refusal names the figure set here. JPEG, PNG, WebP and
# AVIF only, as the API.
# PEXAFY_IMG_MAX_BYTES=10469376
# 1 lets an image URL resolve to a private, loopback or link-local address. For a local
# test only — never on a deployed server.
# PEXAFY_IMG_ALLOW_PRIVATE=0

# ── The reader's selection ────────────────────────────────────────────────────
# Register get_grid_selected_photos (on when unset or empty) — only with the thumbnail
# proxy configured, since the grid is where photos are liked. 0/false/no/off, or any
# other unrecognised value, removes the tool; the grid still reports the selection
# through the host's own channels. See selection.py.
# PEXAFY_SELECTION_TOOL=1
# How long a stored selection is served (seconds), and how long the grid may write
# with the token of one answer.
# PEXAFY_SELECTION_TTL=3600
# PEXAFY_SELECTION_TOKEN_TTL=7200
# Signs those tokens. Unset: PEXAFY_ANON_SECRET, or else a random secret per process
# (selections live in the process's memory anyway).
# PEXAFY_SELECTION_SECRET=

# ── Widget ────────────────────────────────────────────────────────────────────
# The origin ChatGPT attributes the grid to: `openai/widgetDomain` for every host, and
# `_meta.ui.domain` for an OpenAI host (other hosts get the hash Claude requires there).
# PEXAFY_WIDGET_DOMAIN=https://pexafy.com
# Pages allowed to frame GET /widget (CSP frame-ancestors), space-separated.
# PEXAFY_WIDGET_FRAME_ANCESTORS="https://pexafy.com https://www.pexafy.com https://preprod.pexafy.com http://localhost:8000 http://127.0.0.1:8000"
# The grid's first-steps coach plays once per person — anyone the server can name: a
# caller without an account, an OAuth account, a key — remembered in the store below.
# On when unset or empty; 0/false/no/off, or any other unrecognised value, shows it in
# every grid, as before. See coach.py.
# PEXAFY_COACH_ONCE=1

# ── Memory that outlives a restart ────────────────────────────────────────────
# Where the coach (PEXAFY_COACH_ONCE) and the editors' sign-ins (PEXAFY_SIGN_IN_BY_401)
# are remembered: redis://[:password@]host:port/db. Keys are digests under
# `pexafy:mcp:`. Empty: this process's memory, forgotten on a restart (a warning says so
# once). An unreachable or slow Redis never fails a request: the operation is given up
# after its 0.5-second timeout, with a warning. In a Compose file, write a `$` of the
# password as `$$`. See store.py.
# PEXAFY_REDIS_URL=

# ── App directories ───────────────────────────────────────────────────────────
# Token served at /.well-known/openai-apps-challenge for OpenAI's domain check; the
# route exists only when it is set.
# OPENAI_APPS_CHALLENGE=

# ── Hosts on the 0.4.x tool list ──────────────────────────────────────────────
# Keep get_similar_photos, the 0.4.x similar tool, in the tool list an OpenAI host reads,
# with the definition 0.4.12 published, until the app's 1.0.0 tools are approved:
# OpenAI removes from a published app, at its next scan, a tool the list no longer
# names. No other host sees it. On when unset or empty; 0/false/no/off, or any
# other unrecognised value, takes it off the list. Calls under the old name are
# answered either way (search_photos_by_image with that photo_id). See compat.py.
# PEXAFY_SIMILAR_ALIAS=1
# Until this instant, an OpenAI host's search answers keep, in structuredContent,
# everything the 0.4.12 grid reads: the previews as whole links, `urls` in every size,
# the photographer's link, the colour, the date, the long description and `cta`.
# ChatGPT may draw answers with the grid it cached for up to an hour after a deploy, under
# the same URI, and that grid shows no thumbnail from a 1.0.0 answer, whose previews are
# a path without address and which has no `urls`. The text the model reads keeps no
# link, the tool list does not change, and no other host is affected. An instant in UTC,
# as epoch seconds or ISO 8601 (2026-10-05T03:00:00Z). Unset, empty or 0: no window; any
# other value that is not an instant: no window, and a warning in the log. The log says
# at start whether the window is open. On deployment, set it to the time of the deploy
# plus 2 hours. See compat.py.
# PEXAFY_LEGACY_GRID_UNTIL=

# ── Observability ─────────────────────────────────────────────────────────────
# Log level (stdout) of this server's own lines. Whatever it says, the libraries stay at
# INFO at least, httpx and httpcore at WARNING at least — below that they write requests
# whole — and a quieter level (WARNING, ERROR) quiets them too.
# PEXAFY_MCP_LOG_LEVEL=INFO
# Bearer token guarding /metrics, given directly or as a file to read it from (e.g.
# /run/secrets/monitoring_token; the file wins when both are set). Point Prometheus at
# the same secret. Unset, the endpoint is open: fine locally, wrong on a public host.
# PEXAFY_METRICS_TOKEN=
# PEXAFY_METRICS_TOKEN_FILE=
# FastMCP checks PyPI for updates at startup; the server sets this to "off" when it is
# unset, to stay offline. "stable" turns the check back on.
# FASTMCP_CHECK_FOR_UPDATES=off

# ── OpenAPI spec source ───────────────────────────────────────────────────────
# Default: the vendored snapshot (the package's assets/openapi.json) — no network at
# startup. A URL fetches a live spec instead (opt-in); a path reads another local file.
# prepare.sh regenerates the snapshot from PEXAFY_API_BASE_URL.
# PEXAFY_OPENAPI_URL=
# PEXAFY_OPENAPI_PATH=
