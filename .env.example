# Copy to .env and fill in. .env is NEVER committed (see .gitignore).
# In Docker, these come from docker-compose / the environment instead.

# ── API ───────────────────────────────────────────────────────────────────────
# API root (the OpenAPI paths already include /api/v1).
PEXAFY_API_BASE_URL=https://api.pexafy.com
# Optional fallback key used in stdio/dev when the client sends no per-user key.
# Leave empty in per-user HTTP deployments.
PEXAFY_API_KEY=
# Analytics tag sent as the X-Source header.
PEXAFY_SOURCE=MCP-Agent
# PEXAFY_HTTP_TIMEOUT=30
# PEXAFY_HTTP_RETRIES=2
# PEXAFY_MCP_LOG_LEVEL=INFO

# ── OpenAPI spec source ───────────────────────────────────────────────────────
# Default: the vendored snapshot (assets/openapi.json) — no network at startup.
# Set a URL to fetch a live spec instead (opt-in), or a different local path.
# PEXAFY_OPENAPI_URL=
# PEXAFY_OPENAPI_PATH=

# ── Maintainers only: regenerating the vendored assets (prepare.sh) ───────────
# The MCP ships assets/openapi.json + assets/facets.json (so import does no network).
# prepare.sh regenerates them from {API}/schema.json and the live facet value sets —
# the facets fetch needs an api-client key:
# PEXAFY_FACET_BOOTSTRAP_KEY=

# ── Inline result grid (MCP Apps) ─────────────────────────────────────────────
# The search tools render an inline thumbnail grid; thumbnails come from Pexafy's
# OWN signed thumbnail CDN. Set BOTH to enable (mirror the Pexafy thumb proxy).
# PEXAFY_THUMB_BASE_URL=https://thumb.pexafy.com
# PEXAFY_THUMB_HMAC_SECRET=
# PEXAFY_THUMB_WIDTH=480
# PEXAFY_MCP_PREVIEWS=1

# ── Transport ─────────────────────────────────────────────────────────────────
# "stdio" (default, Claude Desktop/Code) or "http" (remote Streamable HTTP).
# PEXAFY_MCP_TRANSPORT=stdio
# PEXAFY_MCP_HOST=127.0.0.1
# PEXAFY_MCP_PORT=8765

# ── OAuth Resource Server (HTTP transport only) ───────────────────────────────
# Engages when ALL are set: lets MCP clients authenticate per-user via OAuth
# (an external Authorization Server) instead of passing a raw API key. See auth.py.
# PEXAFY_OAUTH_RESOLVE_URL=
# PEXAFY_OAUTH_AS_URL=
# PEXAFY_MCP_PUBLIC_URL=
# MCP_RESOLVE_SECRET=
